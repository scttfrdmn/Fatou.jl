# Fatou.jl worker image
# Built automatically by ensure_image() via burst-core image build.
# Uses PackageCompiler.jl sysimage to reduce cold starts from 30-90s to ~2-3s.
#
# Build args:
#   JULIA_VERSION  — e.g. "1.10"
#   PACKAGES       — comma-separated list of package symbols, e.g. ":AWS,:JLD2,:JSON3"
#
# Manual build (for development):
#   docker build -f Dockerfile.worker \
#     --build-arg JULIA_VERSION=1.10 \
#     --build-arg PACKAGES=":AWS,:JLD2,:JSON3,:ProgressMeter,:ClusterManagers" \
#     -t burst-workers-julia:dev .

ARG JULIA_VERSION=1.10
FROM julia:${JULIA_VERSION}

WORKDIR /app

# Copy project files for package installation
COPY Project.toml Manifest.toml ./

# Install all packages declared in Project.toml
RUN julia --project=/app -e 'using Pkg; Pkg.instantiate()'

# Copy precompile script (generated by _generate_precompile_jl)
COPY precompile.jl ./

# Build PackageCompiler sysimage — takes 5-15 minutes on first build.
# The sysimage eliminates JIT compilation latency on worker cold starts.
ARG PACKAGES=":AWS,:JLD2,:JSON3,:ProgressMeter,:Distributed,:ClusterManagers,:Serialization"
RUN julia --project=/app -e " \
    using PackageCompiler; \
    pkgs = Symbol[$(PACKAGES)]; \
    create_sysimage(pkgs, \
        sysimage_path=\"/app/burst.so\", \
        precompile_execution_file=\"/app/precompile.jl\") \
    "

# Copy the self-contained worker entrypoint
COPY src/worker.jl ./worker.jl

# Julia thread count: use all available CPUs in the Fargate task
ENV JULIA_NUM_THREADS=auto

# Worker entrypoint: Julia with sysimage for instant package loading
CMD ["julia", "--sysimage=/app/burst.so", "--project=/app", "worker.jl"]
